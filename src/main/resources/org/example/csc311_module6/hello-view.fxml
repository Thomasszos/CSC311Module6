<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="504.0" prefWidth="310.0" spacing="20.0" style="-fx-background-color: lightblue;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="org.example.csc311_module6.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="239.0" prefWidth="270.0" style="-fx-background-color: white;">
         <children>
            <VBox prefHeight="200.0" prefWidth="363.5" spacing="25.0">
               <children>
                  <Label text="First Name" />
                  <Label text="Last Name" />
                  <Label text="Email" />
                  <Label text="Date of Birth" />
                  <Label text="Zip code" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets left="25.0" top="25.0" />
               </padding>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="363.5" spacing="18.0">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <TextField fx:id="tfFirstName" />
                  <TextField fx:id="tfLastName" />
                  <TextField fx:id="tfEmail" />
                  <TextField fx:id="tfDoB" />
                  <TextField fx:id="tfZipCode" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox prefHeight="203.0" prefWidth="270.0" spacing="10.0" style="-fx-background-color: white; -fx-alignment: center;">
         <children>
            <Label fx:id="lblFirstName" text="Label" />
            <Label fx:id="lblLastName" text="Label" />
            <Label fx:id="lblEmail" text="Label" />
            <Label fx:id="lblDoB" text="Label" />
            <Label fx:id="lblZipCode" text="Label" />
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#NewUI" text="Add" />
         </children>
      </VBox>
   </children>
</VBox>
